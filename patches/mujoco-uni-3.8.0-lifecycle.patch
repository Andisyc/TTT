+// A pool's model/data and completion counter belong to one call at a time.
+class PoolOperation {
+ public:
+  explicit PoolOperation(std::atomic_flag& active) : active_(active) {
+    if (active_.test_and_set(std::memory_order_acquire)) {
+      throw std::runtime_error("BatchEnvPool does not support overlapping operations");
+    }
+  }
+  PoolOperation(const PoolOperation&) = delete;
+  PoolOperation& operator=(const PoolOperation&) = delete;
+  ~PoolOperation() { active_.clear(std::memory_order_release); }
+
+ private:
+  std::atomic_flag& active_;
+};
